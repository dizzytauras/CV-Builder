# Required: OpenAI API credential. Never commit your real key.
OPENAI_API_KEY=replace_me

# Recommended default for this reasoning-heavy prototype.
# Change this to another model available to your OpenAI API project if desired.
OPENAI_MODEL=gpt-6.1-sol

# Optional: if set, the browser will ask for this code before calling the AI API.
ACCESS_CODE=

# Optional tuning
MAX_OUTPUT_TOKENS=4096
RATE_LIMIT_PER_MINUTE=20
